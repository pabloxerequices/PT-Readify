<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
    </configSections>
    <connectionStrings>
        <add name="PT_Readify.Properties.Settings.Base_DadosConnectionString"
            connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\Base_Dados.mdf;Integrated Security=True;Connect Timeout=30"
            providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <!-- Configuração SMTP para envio de recibos de compra -->
        <!-- Alternativa: crie smtp.config na pasta bin\Debug (copie smtp.config.example) -->
        <add key="SmtpHost" value="smtp.gmail.com" />
        <add key="SmtpPort" value="587" />
        <add key="SmtpUser" value="" />
        <add key="SmtpPassword" value="" />
        <add key="SmtpFromEmail" value="" />
        <add key="SmtpFromName" value="PT Readify" />
        <add key="SmtpEnableSsl" value="true" />
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>